{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["./shared/*"]
    }
  },
  "include": ["bin/**/*", "lib/**/*", "lambda/**/*", "shared/**/*", "test/**/*"]
}
