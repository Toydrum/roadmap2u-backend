{
  "name": "roadmap2u-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Serverless AWS backend, web hosting, DNS and OIDC CI/CD infrastructure for RoadMap2U.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toydrum/roadmap2u-backend.git"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "commercial:bootstrap": "node scripts/bootstrap-commercial-flags.mjs",
    "commercial:set": "node scripts/set-commercial-flags.mjs",
    "commercial:freeze": "node scripts/freeze-commercial-cutover.mjs",
    "commercial:inventory": "node scripts/commercial-inventory.mjs",
    "commercial:family-fence": "node scripts/family-fence-backfill.mjs",
    "commercial:access": "node scripts/sponsored-access.mjs",
    "commercial:migrate-hmac": "node scripts/migrate-access-code-hmac.mjs",
    "contracts:check": "vitest run test/contracts-parity.test.ts",
    "contracts:hash": "node scripts/contracts-hash.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1080.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.1080.0",
    "@aws-sdk/client-sts": "3.1080.0",
    "@aws-sdk/credential-provider-node": "^3.972.81",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.267.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vitest": "^4.0.0"
  }
}
