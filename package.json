{
  "name": "roadmap2u-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Serverless AWS backend, web hosting, DNS and OIDC CI/CD infrastructure for RoadMap2U.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toydrum/roadmap2u-backend.git"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "contracts:check": "vitest run test/contracts-parity.test.ts",
    "contracts:hash": "node scripts/contracts-hash.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vitest": "^4.0.0"
  }
}
